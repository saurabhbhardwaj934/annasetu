# Annasetu Server .env.example
# Copy: cp .env.example .env  (phir .env ko edit karo — .env kabhi git pe mat bhejo)

NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/annasetu?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

CORS_ORIGIN=http://localhost:5173
